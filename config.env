# Slinky lab — RKE2 + Cilium on libvirt/KVM
# Source-able shell config. Edit knobs here; scripts read this file.

# Ubuntu cloud image
UBUNTU_CODENAME="noble"   # 24.04 LTS
IMAGE_URL="https://cloud-images.ubuntu.com/${UBUNTU_CODENAME}/current/${UBUNTU_CODENAME}-server-cloudimg-amd64.img"
IMAGE_FILE="ubuntu-${UBUNTU_CODENAME}-cloudimg-amd64.img"

# Libvirt network (the default NAT bridge: virbr0, 192.168.122.0/24)
LIBVIRT_NETWORK="default"
NET_GATEWAY="192.168.122.1"
NET_DNS_PRIMARY="192.168.122.1"
NET_DNS_SECONDARY="1.1.1.1"

# Storage pool on /data (where there's room)
POOL_NAME="slinky"

# VMs: "name vcpus mem_MiB disk_GB ip role"
# role is one of: server, agent
VM_LIST=(
  "cp1     4  8192  60 192.168.122.11 server"
  "worker1 6 16384  80 192.168.122.12 agent"
  "worker2 6 16384  80 192.168.122.13 agent"
)

# RKE2
RKE2_CHANNEL="stable"
RKE2_VERSION=""               # leave empty to use channel; e.g. "v1.35.4+rke2r1"
KUBECTL_REPO_CHANNEL="v1.35"  # apt repo path at pkgs.k8s.io — bump to match RKE2's minor
CLUSTER_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"

# Cilium
CILIUM_HUBBLE_UI="true"

# Paths — auto-detect repo root from this file's location.
# Override by exporting SLINKY_ROOT before invoking make.
: "${SLINKY_ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
IMAGE_DIR="${SLINKY_ROOT}/images"
VM_DIR="${SLINKY_ROOT}/vms"
STATE_DIR="${SLINKY_ROOT}/.state"
SSH_KEY="${STATE_DIR}/ssh_key"

# VM login user (created by cloud-init)
SSH_USER="ubuntu"
