# instant-rke2-lab — RKE2 + Cilium on libvirt/KVM
# Source-able shell config. Edit knobs here; scripts read this file.

# Ubuntu cloud image
UBUNTU_CODENAME="noble"   # 24.04 LTS
IMAGE_URL="https://cloud-images.ubuntu.com/${UBUNTU_CODENAME}/current/${UBUNTU_CODENAME}-server-cloudimg-amd64.img"
IMAGE_FILE="ubuntu-${UBUNTU_CODENAME}-cloudimg-amd64.img"

# Libvirt network (the default NAT bridge: virbr0, 192.168.122.0/24)
LIBVIRT_NETWORK="default"
NET_GATEWAY="192.168.122.1"
NET_DNS_PRIMARY="192.168.122.1"
NET_DNS_SECONDARY="1.1.1.1"

# Libvirt storage pool name
POOL_NAME="rke2-lab"

# VMs: "name vcpus mem_MiB disk_GB ip role"
# role is one of: server, agent
VM_LIST=(
  "cp1     4  8192  60 192.168.122.11 server"
  "worker1 6 16384  80 192.168.122.12 agent"
  "worker2 6 16384  80 192.168.122.13 agent"
)

# RKE2
RKE2_CHANNEL="stable"
RKE2_VERSION=""               # empty: resolved from RKE2_CHANNEL (falls back to newest
                              # GitHub release of KUBECTL_REPO_CHANNEL's minor); e.g. "v1.35.10+rke2r1"
KUBECTL_REPO_CHANNEL="v1.35"  # apt repo path at pkgs.k8s.io — bump to match RKE2's minor
HELM_VERSION="v3.22.1"        # optional labs only: installed by `make extras` (sha256-checked)
CLUSTER_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"

# Cilium
CILIUM_HUBBLE_UI="true"

# GPU passthrough (optional — empty GPU_PCI = off, the default).
# PCI address of an NVIDIA GPU on the host, as `lspci` prints it (e.g. "01:00.0").
# `make gpu-host` binds it — and every other function in its IOMMU group,
# usually the GPU's HDMI audio — to vfio-pci; `make vms` passes them all to
# GPU_VM; `make gpu` installs NVIDIA's GPU Operator, which builds the driver
# inside that VM. The host can't use the GPU while it's passed through.
GPU_PCI=""
GPU_VM="worker1"
GPU_OPERATOR_VERSION="v26.7.3"

# Remote use (lab on a server, kubectl/ssh from another machine).
# `make remote-bundle` writes .state/remote/ for that machine; REMOTE_HOST is
# the address it uses to reach this host (default: auto-detected LAN IP).
REMOTE_HOST="${REMOTE_HOST:-}"

# Paths — auto-detect repo root from this file's location.
: "${LAB_ROOT:=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
IMAGE_DIR="${LAB_ROOT}/images"
VM_DIR="${LAB_ROOT}/vms"
STATE_DIR="${LAB_ROOT}/.state"
SSH_KEY="${STATE_DIR}/ssh_key"

# VM login user (created by cloud-init)
SSH_USER="ubuntu"
